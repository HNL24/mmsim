# data and results are never committed (README figures are whitelisted below)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/README.md
results/*
!results/.gitkeep
!results/readme/

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.hypothesis/
.ipynb_checkpoints/

# os / editors
.DS_Store
.vscode/
.idea/

# local working notes
DECISIONS.md
